<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6. Vosk Mobile Speech SDK (Alpha Cephei)"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Continuous Offline Speech Recognition (Vosk/Kaldi C++ JNI)"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_mic_container">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:contentDescription="@string/mic_icon_desc"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_vosk_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_badge_ok"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Vosk Mobile Engine: Đang sẵn sàng..."
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_vosk_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="Hãy nói khẩu lệnh 'MỞ KHÓA' vào Micro..."
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_vosk_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:padding="12dp"
            android:text="Bật Thu Âm Live Voice Vosk"
            android:textColor="@color/dark_bg"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_close_vosk"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_btn_outlined"
        android:padding="12dp"
        android:text="@string/btn_cancel"
        android:textColor="@color/text_secondary"
        app:strokeWidth="0dp" />

</RelativeLayout>
