<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9. Silero VAD + ONNX (Voice Activity)"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Silero VAD Neural Network Voice Activity Detector &amp; Background Noise Filter"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_mic_container">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:contentDescription="@string/mic_icon_desc"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/primary" />
        </FrameLayout>

        <!-- Live Audio Level Meter -->
        <ProgressBar
            android:id="@+id/pb_vad_mic_level"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:max="5000"
            android:progressDrawable="@drawable/bg_progress_mic" />

        <TextView
            android:id="@+id/tv_vad_mic_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Âm lượng Micro: 0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_vad_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_badge_ok"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Màn hình đã khóa! Hãy nói MỞ KHÓA..."
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_vad_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="Cần nói đúng mật khẩu: 'MỞ KHÓA'"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_vad_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:padding="12dp"
            android:text="Bật Silero VAD Neural Detector"
            android:textColor="@color/dark_bg"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_fallback_pin"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_btn_outlined"
        android:padding="12dp"
        android:text="@string/enter_pin"
        android:textColor="@color/primary"
        app:strokeWidth="0dp" />

</RelativeLayout>
