<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Glowing Lock Header -->
        <ImageView
            android:id="@+id/iv_lock_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_mic_container"
            android:contentDescription="@string/lock_icon_desc"
            android:padding="16dp"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.08"
            android:text="@string/voice_lock_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_say_passphrase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/say_passphrase"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Microphone Visual Pulse Container -->
        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_mic_container">

            <ImageView
                android:id="@+id/iv_mic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@string/mic_icon_desc"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/primary" />
        </FrameLayout>

        <!-- Live Audio Level Meter -->
        <ProgressBar
            android:id="@+id/pb_mic_level"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:max="5000"
            android:progressDrawable="@drawable/bg_progress_mic" />

        <TextView
            android:id="@+id/tv_mic_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Âm lượng Micro: 0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Status & Live Result Badge -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_badge_ok"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/listening_status"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_live_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:minHeight="40dp"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="italic" />

    </LinearLayout>

    <!-- Fallback PIN Button -->
    <Button
        android:id="@+id/btn_fallback_pin"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_outlined"
        android:padding="12dp"
        android:text="@string/enter_pin"
        android:textColor="@color/primary"
        app:strokeWidth="0dp" />

</RelativeLayout>
